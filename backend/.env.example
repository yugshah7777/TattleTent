# =============================================================================
# TattleTent — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:5173

# ── PostgreSQL (Neon / local) ────────────────────────────────────────────────
DB_USER=postgres
DB_HOST=localhost
DB_NAME=tattletent
DB_PASSWORD=your_secure_password
DB_PORT=5432

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars_long
JWT_EXPIRE=7d

# ── Google OAuth 2.0 ────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (Nodemailer / Gmail SMTP) ─────────────────────────────────────────
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# ── ICP / DFINITY Integration ────────────────────────────────────────────────
# Keep false when ICP runtime is unavailable (local dev without dfx).
# Set true only after deploying the audit_ledger canister.
ICP_ENABLED=false
ICP_HOST=http://127.0.0.1:4943
ICP_AUDIT_CANISTER_ID=
ICP_RETRY_ATTEMPTS=2
ICP_RETRY_BACKOFF_MS=350