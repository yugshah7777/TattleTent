# =============================================================================
# TattleTent Frontend — Environment Configuration Template
# =============================================================================
# Copy this file to .env in the frontend/ directory and fill in your values.
# NEVER commit the actual .env file to version control.
# =============================================================================

# Backend API URL (Vite exposes this to client code via import.meta.env)
# Change this to your production backend URL when deploying.
VITE_API_URL=http://localhost:5000